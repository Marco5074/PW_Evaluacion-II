{
  "info": {
    "name": "Evaluación II - Reactor y AstroLogistics",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden sobre una API local de pruebas. La colección reinicia la misión al comenzar y terminar; verifica las cinco rutas obligatorias, errores, confirmación, sesión y reactor. El vencimiento temporal está cubierto por npm --prefix backend test."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Preparar y consultar",
      "item": [
        {
          "name": "Reiniciar misión de pruebas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/sesion/reiniciar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Inventario: siete suministros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/inventario"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Comprobación 1\", function () { pm.expect(pm.response.json()).to.have.lengthOf(7); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Carga inicial: presupuesto 500 y total 0",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/carga"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Comprobación 1\", function () { pm.expect(pm.response.json().creditos).to.eql(500); });",
                  "pm.test(\"Comprobación 2\", function () { pm.expect(pm.response.json().total).to.eql(0); });",
                  "pm.test(\"Comprobación 3\", function () { pm.expect(pm.response.json().itemsCargados).to.have.lengthOf(0); });",
                  "pm.test(\"Comprobación 4\", function () { pm.expect(pm.response.json().confirmada).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirmar carga vacía: rechazado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/carga/confirmar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Comprobación 1\", function () { pm.expect(pm.response.json().mensaje).to.be.a('string'); });"
                ]
              }
            }
          ]
        }
      ]
    },
